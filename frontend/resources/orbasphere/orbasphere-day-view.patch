+// ═════════════════════════════════════════════════════════════════════════════
+//  VUE DEPUIS L'ORBASPHÈRE (.space-bg.day)
+//  La nuit on regarde le vide ; le jour, la Terre depuis la station. Le bleu
+//  atmosphérique est le fond de l'hôte (--m-sky). Seuls bougent les nuages
+//  (rotation de la Terre) et le reflet sur le panneau solaire, en `transform`
+//  seulement ; dans /game (mode calme), tout est figé. Aucun calque n'est créé
+//  ni détruit tant qu'on reste dans le même mode.
+//  Ordre d'empilement : Terre, reflet sur l'océan, ombre basse du cadre, aile,
+//  ombre haute du cadre (au-dessus de l'aile, sous la barre d'état).
+// ═════════════════════════════════════════════════════════════════════════════
+
+// Le voile sombre du mode calme n'a pas lieu d'être de jour.
+.space-bg.day.calm {
+  background: none;
+}
+
+// ─── La Terre ────────────────────────────────────────────────────────────────
+// Un disque de 2,2 largeurs d'écran, écrasé de moitié en hauteur : vu en
+// rasant depuis l'orbite. Seul son haut entre dans le cadre, le limbe passe à
+// 64 % de la hauteur au centre et descend vers les bords (~22 px sur un
+// téléphone, ~80 px sur un écran de bureau). Toutes les couches internes sont
+// des disques de même centre.
+.orb-earth {
+  --earth: 220vw;
+  position: absolute;
+  top: 64%;
+  left: 50%;
+  width: var(--earth);
+  height: var(--earth);
+  margin-left: calc(var(--earth) * -0.5);
+  transform-origin: 50% 0;
+  transform: scaleY(0.5);
+}
+
+// Limbe : la mince couche d'atmosphère éclairée, juste au-dessus du bord du
+// disque (le disque recouvre l'intérieur). Le bord est à 92,6 % du rayon de
+// ce calque, plus grand de 4 % de chaque côté.
+.orb-earth__limb {
+  position: absolute;
+  inset: -4%;
+  border-radius: 50%;
+  background: radial-gradient(
+    closest-side,
+    rgba(220, 242, 255, 0) 91.4%,
+    rgba(220, 242, 255, 0.95) 92.6%,
+    rgba(150, 206, 250, 0.55) 94.2%,
+    rgba(90, 160, 235, 0.18) 97%,
+    rgba(90, 160, 235, 0) 100%
+  );
+}
+
+// Océan : bleu profond, qui s'éclaircit vers le limbe où on le voit à travers
+// plus d'atmosphère.
+.orb-earth__ocean {
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  background: radial-gradient(
+    closest-side,
+    #062449 0%,
+    #072b56 68%,
+    #0a3a6e 82%,
+    #13508f 90%,
+    #2a72b8 95.5%,
+    #5a9fda 98.6%,
+    #a9d8f5 100%
+  );
+}
+
+// Fonds marins et nuages : une texture en disque, pré-calculée hors ligne
+// (un filtre SVG serait recalculé à la résolution de l'écran, une saccade
+// visible sur Android). Le calque tourne autour du centre de la Terre : les
+// nuages glissent le long de la courbure, un tour en 40 minutes.
+.orb-earth__weather {
+  position: absolute;
+  inset: 0;
+  display: block;
+  width: 100%;
+  height: 100%;
+  will-change: transform;
+  animation: orb-turn 2400s linear infinite;
+}
+
+@keyframes orb-turn {
+  to { transform: rotate(360deg); }
+}
+
+// Voile d'atmosphère sur le bord : les nuages lointains se fondent dans le
+// limbe au lieu de s'arrêter net.
+.orb-earth__haze {
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  background: radial-gradient(
+    closest-side,
+    rgba(150, 205, 248, 0) 84%,
+    rgba(150, 205, 248, 0.22) 92%,
+    rgba(200, 234, 255, 0.55) 97.5%,
+    rgba(232, 247, 255, 0.85) 100%
+  );
+}
+
+// Reflet du soleil sur l'océan, côté droit (le soleil est à droite, comme
+// l'indique le reflet sur le panneau). En coordonnées d'écran, statique.
+.orb-sunglint {
+  position: absolute;
+  top: 69%;
+  left: 48%;
+  width: 64vw;
+  height: 22vh;
+  background: radial-gradient(
+    ellipse closest-side,
+    rgba(228, 242, 255, 0.42) 0%,
+    rgba(200, 228, 252, 0.16) 48%,
+    rgba(200, 228, 252, 0) 100%
+  );
+}
+
+// Ombre du cadre de la baie d'observation : en bas, la vue s'arrête où
+// commence la station et le pied de page reste lisible même posé sur un
+// nuage ; en haut, la barre d'état reste lisible quand l'aile passe dessous.
+.orb-frame-shade {
+  position: absolute;
+  inset: auto 0 0;
+  height: 30%;
+  background: linear-gradient(to top, rgba(3, 16, 38, 0.62), rgba(3, 16, 38, 0.26) 40%, rgba(3, 16, 38, 0));
+}
+
+.orb-frame-shade--top {
+  inset: 0 0 auto;
+  height: calc(var(--sa-top, 0px) + 56px);
+  background: linear-gradient(to bottom, rgba(3, 16, 38, 0.72), rgba(3, 16, 38, 0.3) 55%, rgba(3, 16, 38, 0));
+}
+
+// ─── Panneau solaire de la station ───────────────────────────────────────────
+// Aile au premier plan (dessinée en perspective, voir le gabarit) qui traverse
+// le coin haut gauche : elle entre par le bord gauche et sort par le haut.
+// Cellules or des couvertures de l'ISS, mât en aluminium. Taille bornée pour
+// que son bord bas passe au-dessus du titre de l'accueil.
+.orb-array {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: min(56vw, 460px);
+  aspect-ratio: 1;
+}
+
+.orb-array__wing {
+  display: block;
+  width: 100%;
+  height: 100%;
+}
+
+.orb-array__blanket {
+  fill: url(#orb-array-cells);
+}
+
+.orb-array__cells {
+  fill: none;
+  stroke: #3a240a;
+  stroke-opacity: 0.55;
+  stroke-width: 1;
+  vector-effect: non-scaling-stroke;
+}
+
+.orb-array__frame {
+  fill: none;
+  stroke: #e3eaf0;
+  stroke-opacity: 0.75;
+  stroke-width: 1.2;
+  vector-effect: non-scaling-stroke;
+}
+
+.orb-array__metal {
+  fill: url(#orb-array-metal);
+}
+
+// Reflet du soleil : une bande claire, en travers de l'aile, la balaie du
+// bout proche (bas gauche) vers le bout lointain (haut), puis l'aile reste au
+// repos. Découpée à la partie visible de l'aile (mêmes points que le SVG, en
+// % de la boîte).
+.orb-array__glint {
+  position: absolute;
+  inset: 0;
+  clip-path: polygon(0 14.2%, 18% 0, 90.5% 0, 0 94.2%);
+}
+
+.orb-array__shine {
+  position: absolute;
+  inset: -50%;
+  background: linear-gradient(
+    45deg,
+    rgba(255, 246, 220, 0) 44%,
+    rgba(255, 246, 220, 0.45) 47.5%,
+    rgba(255, 253, 244, 0.9) 50%,
+    rgba(255, 246, 220, 0.45) 52.5%,
+    rgba(255, 246, 220, 0) 56%
+  );
+  transform: translate(-45%, 45%);
+  will-change: transform;
+  animation: orb-glint 13s ease-in-out 2s infinite;
+}
+
+@keyframes orb-glint {
+  0% { transform: translate(-45%, 45%); }
+  24% { transform: translate(45%, -45%); }
+  100% { transform: translate(45%, -45%); }
+}
+
+// Partie en cours : la Terre ne tourne plus, le panneau ne brille plus.
+.space-bg.calm {
+  .orb-earth__weather {
+    animation-play-state: paused;
+  }
+
+  .orb-array__shine {
+    animation: none;
+    opacity: 0;
+  }
+}
+
 // Respect des préférences d'accessibilité : on fige les animations.
 @media (prefers-reduced-motion: reduce) {
   .nebula,
@@ -407,4 +625,6 @@ $space-glow: #1a2840;
   }
   .shooting-star,
   .spaceship { opacity: 0; }
+  .orb-earth__weather { animation-play-state: paused !important; }
+  .orb-array__shine { animation: none !important; opacity: 0; }
 }
